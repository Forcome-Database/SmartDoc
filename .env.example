# Dify AI 知识库配置
# 复制此文件为 .env 并填入实际值

# ===== AI 模式选择 =====
# 可选值: api | embed
# - api: 使用 Dify API 进行 SSE 流式对话（默认）
# - embed: 使用 Dify iframe 嵌入链接
VITE_DIFY_MODE=api

# ===== API 模式配置 =====
# 当 VITE_DIFY_MODE=api 时需要配置以下变量

# Dify API 基础 URL
# 示例: https://api.dify.ai 或自托管实例地址
VITE_DIFY_API_BASE=https://api.dify.ai/v1

# Dify API 密钥
# 从 Dify 控制台获取应用的 API 密钥
VITE_DIFY_API_KEY=app-your-api-key

# ===== 嵌入模式配置 =====
# 当 VITE_DIFY_MODE=embed 时需要配置以下变量

# Dify 嵌入链接 URL
# 从 Dify 控制台获取应用的嵌入链接
# 示例: https://udify.app/chatbot/xxxxx
VITE_DIFY_EMBED_URL=

# ===== Admin 后台配置 =====

# PostgreSQL 数据库连接 URL
# 示例: postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://user:password@localhost:5432/forcome_docs

# Nuxt Session 密码（至少 32 字符）
NUXT_SESSION_PASSWORD=your-super-secret-session-password-at-least-32-chars

# 钉钉 OAuth 配置
DINGTALK_APP_KEY=your-dingtalk-app-key
DINGTALK_APP_SECRET=your-dingtalk-app-secret
DINGTALK_AGENT_ID=your-dingtalk-agent-id

# OpenAI API 配置（用于 AI 翻译）
OPENAI_API_KEY=sk-your-openai-api-key
# OpenAI API Base URL（可选，用于代理或兼容 API）
# 示例: https://api.openai-proxy.com/v1
OPENAI_BASE_URL=

# 文档根目录（相对于 admin 目录）
DOCS_ROOT=../docs

# ===== MinIO 对象存储配置 =====

# MinIO 服务器地址（不含协议）
MINIO_ENDPOINT=localhost

# MinIO 端口
MINIO_PORT=9000

# 是否使用 SSL
MINIO_USE_SSL=false

# MinIO 访问密钥
MINIO_ACCESS_KEY=your-minio-access-key

# MinIO 密钥
MINIO_SECRET_KEY=your-minio-secret-key

# MinIO Bucket 名称
MINIO_BUCKET=forcome-docs

# MinIO 公开访问 URL（可选，用于 CDN 或反向代理）
# 示例: https://cdn.example.com
MINIO_PUBLIC_URL=
