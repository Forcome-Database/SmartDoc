# Dify AI 知识库配置
# 复制此文件为 .env 并填入实际值

# ===== AI 模式选择 =====
# 可选值: api | embed
# - api: 使用 Dify API 进行 SSE 流式对话（默认）
# - embed: 使用 Dify iframe 嵌入链接
VITE_DIFY_MODE=api

# ===== API 模式配置 =====
# 当 VITE_DIFY_MODE=api 时需要配置以下变量

# Dify API 基础 URL
# 示例: https://api.dify.ai 或自托管实例地址
VITE_DIFY_API_BASE=https://api.dify.ai/v1

# Dify API 密钥
# 从 Dify 控制台获取应用的 API 密钥
VITE_DIFY_API_KEY=app-your-api-key

# ===== 嵌入模式配置 =====
# 当 VITE_DIFY_MODE=embed 时需要配置以下变量

# Dify 嵌入链接 URL
# 从 Dify 控制台获取应用的嵌入链接
# 示例: https://udify.app/chatbot/xxxxx
VITE_DIFY_EMBED_URL=
